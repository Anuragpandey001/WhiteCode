# Used automatically by `next build`/`next start` (production mode).
# Local dev keeps using apps/web/.env.local (http://localhost:4001/api/v1).
NEXT_PUBLIC_API_URL=https://novacraft-api.onrender.com/api/v1

# Update this once the website itself has a live domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
